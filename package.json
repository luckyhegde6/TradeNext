{
  "name": "tradenext",
  "version": "1.0.0",
  "description": "This bundle contains starter code to add to your existing `TradeNext` repository: - Postgres/Timescale DB migrations - Node TypeScript ingestion script to consume NSE-style CSV and upsert into Timescale - Next.js starter pages: dashboard, holdings, company profile (demo charts) - Piotroski F-score SQL function + TypeScript helper - docker-compose for local dev (Postgres+Timescale, Redis, API, Frontend) - AI TODO checklist for implementing remaining features",
  "main": "index.js",
  "directories": {
    "lib": "lib",
    "prisma": "prisma",
    "scripts": "scripts"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:bg": "powershell -ExecutionPolicy Bypass -File scripts/start-dev-bg.ps1",
    "stage": "netlify dev",
    "dev:local": "node scripts/dev-local-cross.js",
    "dev:clean": "bash scripts/dev-clean.sh",
    "dev:only-host": "node scripts/dev-only-host-cross.cjs",
    "local": "npm run dev:only-host && npm run dev",
    "local:clean": "npm run dev:clean && npm run dev:only-host && npm run dev",
    "quickbuild": "node scripts/copy-sql-wasm.mjs && next build && node scripts/copy-sql-wasm-netlify.mjs",
    "build": "npx prisma migrate deploy && node scripts/copy-sql-wasm.mjs && next build && node scripts/copy-sql-wasm-netlify.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate-client": "node scripts/generate-client.js",
    "ingest:run": "NODE_ENV=development node ./scripts/runIngest.js",
    "ingest:zip": "ts-node scripts/ingest_nse_zip.ts",
    "postinstall": "npx prisma generate --schema=prisma/schema.prisma",
    "prisma:gen": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name add_indexname_to_announcements",
    "prisma:studio": "prisma studio",
    "timescale:enable": "ts-node scripts/enable_timescale.ts",
    "db:up": "bash scripts/dev-db-up.sh",
    "db:down": "bash scripts/dev-db-down.sh",
    "dbprod": "cross-env USE_REMOTE_DB=true npm run dev",
    "dbprod:build": "cross-env NODE_ENV=production USE_REMOTE_DB=true npm run quickbuild",
    "db:enable-timescale": "npx ts-node scripts/enable_timescale.ts",
    "docker:terminate:win": "powershell -ExecutionPolicy Bypass -File scripts/docker-terminate.ps1",
    "docker:terminate": "node scripts/docker-terminate-cross.cjs",
    "fetch:scrips": "npx tsx scripts/fetch-nse-scrips.ts",
    "predeploy:preserve": "node scripts/predeploy/preserve-mirror.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@huggingface/tokenizers": "^0.2.0",
    "@netlify/blobs": "^11.1.9",
    "@next/third-parties": "^16.4.6",
    "@openrouter/agent": "^1.2.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/extension-accelerate": "^3.0.1",
    "@prisma/instrumentation": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/node-cache": "^4.2.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/sql.js": "^1.4.11",
    "@types/unzipper": "^0.10.11",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.6",
    "chart.js": "^4.6.1",
    "csv-parse": "^7.0.3",
    "csv-parser": "^3.2.1",
    "fetch-cookie": "^3.2.0",
    "googleapis": "^190.0.0",
    "morgan": "^1.12.1",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.6.0",
    "onnxruntime-node": "^1.31.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.2",
    "sql.js": "^1.16.0",
    "swr": "^2.5.1",
    "tailwindcss": "^4.3.5",
    "tough-cookie": "^6.1.0",
    "typescript": "^7.0.2",
    "unzipper": "^0.12.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@netlify/plugin-nextjs": "^5.16.7",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/jest": "^30.0.0",
    "@types/nodemailer": "^8.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "js-yaml": "4.3.2"
    },
    "@humanfs/node": "0.16.8",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.2"
    },
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.8",
    "mysql2": "3.24.4",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luckyhegde6/TradeNext.git"
  },
  "keywords": [],
  "author": "",
