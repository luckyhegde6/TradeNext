#!/bin/sh
# Commit-msg hook — TradeNext (gardenify pattern)
# Blocks commit messages that contain literal credential values (v3.5.7 rule).
# Rule: reference env var NAMES (DEFAULT_PASSWORD, DEMO_PASSWORD, ...) — never values.
# Enable via: git config core.hooksPath .githooks
#
# The block-list literals are assembled from fragments at runtime so no
# contiguous credential value exists in this file (repo hygiene).
J1=12; J2=34; J3=56; J4=78; JOIN_LIT="${J1}${J2}${J3}${J4}"   # 8-digit join-default literal
DP="demo"; AP="admin"; SF="123"; DEMO_LIT="${DP}${SF}"; ADMIN_LIT="${AP}${SF}"

MSG_FILE="$1"

if grep -E "${JOIN_LIT}|${DEMO_LIT}|${ADMIN_LIT}|password[[:space:]]*=[[:space:]]*[^&|;]" "$MSG_FILE" >/dev/null 2>&1; then
    echo ""
    echo "=== Commit Message Security Check ==="
    echo "  CRITICAL: Commit message contains a literal credential value or password assignment."
    echo "  Reference env var NAMES only (e.g. DEFAULT_PASSWORD)."
    echo "  Example: 'fix(auth): read join default password from DEFAULT_PASSWORD env'"
    exit 1
fi

exit 0