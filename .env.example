# Google Sheets Tracking Environment Variables
# These 5 vars are required for the Google Sheets tracker to operate.
# The admin console (Spec 31) reports missing vars via `missingEnvVars`
# and the verify script (scripts/google-sheets/verify-prod-env.ts)
# exits 1 or 2 depending on which are absent.
#
# All values are placeholder-only — never commit real credentials.

# Master switch: must be exactly "true" for tracking to be enabled.
GOOGLE_SHEETS_TRACKING_ENABLED="true"

# OAuth client credentials (populated by Google Cloud Console).
GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

# Refresh token from a Google Service Account or OAuth flow.
# Without this, no Oauth scope is possible and no rows can be appended.
GOOGLE_OAUTH_REFRESH_TOKEN="YOUR_GOOGLE_OAUTH_REFRESH_TOKEN"

# Spreadsheet id for the tracker (the "sheet" rows append to).
# Find this in the sheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID="YOUR_GOOGLE_SHEET_ID"